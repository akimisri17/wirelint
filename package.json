{
  "name": "@akhil-misri/wirelint",
  "version": "0.3.1",
  "description": "Zero-config CLI that catches cross-service environment-variable mistakes before deploy.",
  "keywords": [
    "env",
    "environment-variables",
    "dotenv",
    "lint",
    "config",
    "microservices",
    "monorepo",
    "deploy",
    "ci",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akimisri17/wirelint.git"
  },
  "homepage": "https://github.com/akimisri17/wirelint#readme",
  "bugs": {
    "url": "https://github.com/akimisri17/wirelint/issues"
  },
  "type": "module",
  "bin": {
    "wirelint": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "ROADMAP.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "npm run build",
    "pretest": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
